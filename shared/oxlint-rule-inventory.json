      "typeAware": false
    },
    "typescript/no-unsafe-declaration-merging": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": false
    },
    "typescript/no-misused-new": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": false
    },
    "typescript/no-duplicate-enum-values": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": false
    },
    "typescript/no-extra-non-null-assertion": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": false
    },
    "typescript/no-non-null-asserted-optional-chain": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": false
    },

    "typescript/no-explicit-any": {
      "plugin": "typescript",
      "category": "restriction",
      "typeAware": false
    },
    "typescript/no-unsafe-assignment": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/no-unsafe-member-access": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/no-unsafe-argument": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/no-unsafe-call": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/no-unsafe-return": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/restrict-plus-operands": {
      "plugin": "typescript",
      "category": "pedantic",
