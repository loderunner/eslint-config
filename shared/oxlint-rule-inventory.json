{
  "$schema": "https://oxc.rs/docs/guide/usage/linter/rules.html",
  "_meta": {
    "description": "Committed scrape of the oxlint rules reference (rule id -> plugin, category, type-aware, added-in version). Used by the shared/test/rule-map.test.js drift test to catch oxlint renaming or removing a rule that eslint-config-loderunner's presets map onto, and to guard against restating no-op rules. Verified 2026-08-26/2026-08-27 against https://oxc.rs/docs/guide/usage/linter/rules/<plugin>/<rule>.html.",
    "verifiedOn": "2026-08-27"
  },
  "rules": {
    "eslint/eqeqeq": {
      "plugin": "eslint",
      "category": "pedantic",
      "typeAware": false
    },
    "eslint/no-var": {
      "plugin": "eslint",
      "category": "restriction",
      "typeAware": false
    },
    "eslint/no-duplicate-imports": {
      "plugin": "eslint",
      "category": "style",
      "typeAware": false
    },
    "eslint/no-unused-vars": {
      "plugin": "eslint",
      "category": "correctness",
      "typeAware": false
    },
    "eslint/curly": {
      "plugin": "eslint",
      "category": "style",
      "typeAware": false
    },
    "eslint/no-array-constructor": {
      "plugin": "eslint",
      "category": "pedantic",
      "typeAware": false
    },
    "eslint/no-case-declarations": {
      "plugin": "eslint",
      "category": "pedantic",
      "typeAware": false
    },
    "eslint/no-fallthrough": {
      "plugin": "eslint",
      "category": "pedantic",
      "typeAware": false
    },
    "eslint/no-prototype-builtins": {
      "plugin": "eslint",
      "category": "pedantic",
      "typeAware": false
    },
    "eslint/no-empty": {
      "plugin": "eslint",
      "category": "restriction",
      "typeAware": false
    },
    "eslint/no-regex-spaces": {
      "plugin": "eslint",
      "category": "restriction",
      "typeAware": false
    },

    "typescript/switch-exhaustiveness-check": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/strict-boolean-expressions": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/prefer-nullish-coalescing": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/no-unnecessary-condition": {
      "plugin": "typescript",
      "category": "nursery",
      "typeAware": true,
      "notes": "not covered by semver; may be renamed/removed in a patch"
    },
    "typescript/no-misused-promises": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },
    "typescript/consistent-type-imports": {
      "plugin": "typescript",
      "category": "style",
      "typeAware": false
    },
    "typescript/no-deprecated": {
      "plugin": "typescript",
      "category": "pedantic",
      "typeAware": true
    },

    "typescript/await-thenable": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": true
    },
    "typescript/no-floating-promises": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": true
    },
    "typescript/no-base-to-string": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": true
    },
    "typescript/no-implied-eval": {
      "plugin": "typescript",
      "category": "correctness",
      "typeAware": true
