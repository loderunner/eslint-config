      "typeAware": false
    },
    "vitest/no-identical-title": {
      "plugin": "vitest",
      "category": "style",
      "typeAware": false
    },
    "vitest/no-import-node-test": {
      "plugin": "vitest",
      "category": "style",
      "typeAware": false
    },
    "vitest/no-interpolation-in-snapshots": {
      "plugin": "vitest",
      "category": "style",
      "typeAware": false
    },
    "vitest/no-mocks-import": {
      "plugin": "vitest",
      "category": "style",
      "typeAware": false
    },
    "vitest/require-mock-type-parameters": {
      "plugin": "vitest",
      "category": "correctness",
      "typeAware": false,
      "notes": "correctness, so on by default under categories.correctness — the vitest test-file override turning it off is not a no-op"
    },
    "vitest/no-unneeded-async-expect-function": {
      "plugin": "vitest",
      "category": "style",
      "typeAware": false,
      "notes": "not present in the abbreviated oxc.rs rules index fetched 2026-08-27; existence carried over from the migration plan's rule-by-rule 200-check verification"
    },
    "vitest/prefer-called-exactly-once-with": {
      "plugin": "vitest",
      "category": "style",
      "typeAware": false
    },

    "loderunner/no-chained-arrow": {
      "plugin": "loderunner",
      "category": "js-plugin",
      "typeAware": false,
      "notes": "custom rule shipped via jsPlugins from eslint-plugin-loderunner, not a native category-based rule"
    }
  }
}
