    },
    "typescript/no-empty-object-type": {
      "plugin": "typescript",
      "category": "restriction",
      "typeAware": false
    },
    "typescript/no-namespace": {
      "plugin": "typescript",
      "category": "restriction",
      "typeAware": false
    },
    "typescript/no-require-imports": {
      "plugin": "typescript",
      "category": "restriction",
      "typeAware": false
    },
    "typescript/no-unnecessary-type-assertion": {
      "plugin": "typescript",
      "category": "suspicious",
      "typeAware": true
    },
    "typescript/no-unsafe-enum-comparison": {
      "plugin": "typescript",
      "category": "suspicious",
      "typeAware": true
    },
    "typescript/no-unnecessary-type-constraint": {
      "plugin": "typescript",
      "category": "suspicious",
      "typeAware": false
    },

    "react/rules-of-hooks": {
      "plugin": "react",
      "category": "pedantic",
      "typeAware": false
    },
    "react/exhaustive-deps": {
      "plugin": "react",
      "category": "correctness",
      "typeAware": false
    },
    "react/display-name": {
      "plugin": "react",
      "category": "pedantic",
      "typeAware": false
    },
    "react/jsx-no-comment-textnodes": {
      "plugin": "react",
      "category": "suspicious",
      "typeAware": false
    },
    "react/jsx-no-target-blank": {
      "plugin": "react",
      "category": "pedantic",
      "typeAware": false
    },
    "react/no-unescaped-entities": {
      "plugin": "react",
      "category": "pedantic",
      "typeAware": false,
      "notes": "not present in the abbreviated oxc.rs rules index fetched 2026-08-27; category carried over from the migration plan's rule-by-rule 200-check verification"
    },
    "react/no-unknown-property": {
      "plugin": "react",
      "category": "restriction",
      "typeAware": false
    },
    "react/purity": {
      "plugin": "react",
      "category": "correctness",
