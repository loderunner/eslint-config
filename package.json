{
  "name": "eslint-config",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "prettier --check . && eslint --max-warnings=0",
    "lint:fix": "prettier --write . && eslint --fix",
    "save-exact-dev-dependencies": "jq -r '.devDependencies | keys[]' package.json | xargs pnpm ls --json | jq -r '.[0].devDependencies[] | \"\\(.from)@\\(.version)\"' | xargs pnpm add --save-dev",
    "generate:oxc": "node scripts/generate-oxc-artifacts.js",
    "test": "vitest run",
    "test:rules": "vitest run --project rules",
    "test:acceptance": "vitest run --project acceptance",
    "test:acceptance:oxc": "vitest run --project acceptance-oxc"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "vitest": "4.1.11"
  }
}
